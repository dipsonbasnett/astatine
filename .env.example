# Copy to .env for server-side use only. Never commit real values.
# Browser code may use only VITE_* variables; publishable/anon key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only. Never prefix with VITE_ or expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server-side only. Never expose image-analysis provider keys to the browser.
IMAGE_ANALYSIS_API_KEY=
