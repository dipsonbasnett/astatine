{
  "name": "astatine",
  "version": "0.1.0",
  "private": true,
  "description": "Mission-ready health intelligence for human spaceflight — an accessible, browser-local foundation for simulated long-duration missions.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dipsonbasnett/astatine.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @astatine/web",
    "build": "npm run build --workspace @astatine/web",
    "build:release": "npm run build:release --workspace @astatine/web",
    "preview": "npm run preview --workspace @astatine/web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "npm run test --workspace @astatine/web",
    "test:watch": "npm run test:watch --workspace @astatine/web",
    "test:e2e": "npm run test:e2e --workspace @astatine/web",
    "test:e2e:install": "npm run test:e2e:install --workspace @astatine/web",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
